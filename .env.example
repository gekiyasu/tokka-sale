# ==========================================
# Amazon Affiliate / Associate Settings
# ==========================================
AMAZON_ASSOCIATE_TAG=your-tag-22

# ==========================================
# Keepa API Settings (Data Provider)
# APIキーは https://keepa.com/ で取得可能
# 空白の場合はテスト用モックデータで自動動作します
# ==========================================
KEEPA_API_KEY=

# ==========================================
# Filtering Settings
# ==========================================
MIN_DISCOUNT_PERCENT=20
MIN_RATING=3.8
MIN_REVIEWS_COUNT=10
CHECK_INTERVAL_MINUTES=120
INTERVAL_JITTER_MINUTES=25

# ==========================================
# X (Twitter) Settings (Selenium または API)
# ==========================================
ENABLE_X=false
X_USE_SELENIUM=true
X_HEADLESS=false
X_CHROME_PROFILE_DIR=chrome_profile_x
# true: 画像を添付 / false: URLのリンクカード(画像タップでサイトへ遷移)
X_ATTACH_IMAGE=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# ==========================================
# Discord Webhook Settings (即座に利用可能)
# Discordチャンネルの「連携サービス」からWebhook URLを作成
# ==========================================
ENABLE_DISCORD=false
DISCORD_WEBHOOK_URL=

# ==========================================
# Telegram Bot Settings
# @BotFather からボット作成、チャットIDを指定
# ==========================================
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# Bluesky Settings
# ==========================================
ENABLE_BLUESKY=false
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ==========================================
# 大特価まとめサイト (クッションページ) 設定
# GitHub Pages等の公開URLを設定するとSNS投稿のリンク先が自動でまとめサイト経由になります
# 例: SITE_BASE_URL=https://username.github.io/tokka-sale
# ==========================================
ENABLE_SITE_GENERATION=true
SITE_TITLE=特価速報ナビ｜Amazonタイムセール・大特価まとめ
SITE_BASE_URL=
AUTO_GIT_PUSH=false
SITE_MAX_ITEMS=100
SITE_MAX_AGE_DAYS=3

# ==========================================
# クリック自動収集 ＆ 学習ループ (Auto-PDCA)
# Google Apps Script (GAS) WebhookのURL、またはGA4測定ID
# ==========================================
CLICK_TRACKER_URL=
GA_MEASUREMENT_ID=
